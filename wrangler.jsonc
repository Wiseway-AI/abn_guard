{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "abn-guard-v2",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "./worker/index.ts",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "abn-guard-v2-db",
      "database_id": "e3ebdcf9-db82-49ca-88f8-45ccc5217622",
      "migrations_dir": "drizzle"
    }
  ],
  "vars": {
    "APP_URL": "https://abn-guard-v2.percival-0ae.workers.dev",
    "GOOGLE_CLIENT_ID": "935832651296-31gf3fi5242sq2g6smh1kldfdo1c0eoo.apps.googleusercontent.com",
    "STRIPE_STARTER_PRICE_ID": "price_1U3QQYBxIBEy9Vo6cgFVyWms",
    "CONTACT_TO_EMAIL": "percival@wiseway.ai"
  }
}
